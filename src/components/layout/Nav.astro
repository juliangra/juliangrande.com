---
import { SITE } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2 sm:px-6"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-semibold tracking-tight text-slate-900 transition-colors hover:text-accent-600 dark:text-slate-50 dark:hover:text-accent-300"
      aria-current={pathname === '/' ? 'page' : undefined}
    >
      {SITE.name}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center" role="list">
        {
          SITE.nav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center px-2.5 text-sm font-medium underline-offset-[6px] transition-colors sm:px-3',
                  isActive(href)
                    ? 'text-slate-900 underline decoration-accent-600 decoration-2 dark:text-slate-50 dark:decoration-accent-300'
                    : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
