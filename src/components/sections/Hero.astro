---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/data/site';

const textLink =
  'inline-flex min-h-11 items-center gap-1 text-sm font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-950 hover:decoration-accent-600 dark:text-slate-300 dark:decoration-slate-600 dark:hover:text-white dark:hover:decoration-accent-300';

const external = [
  SITE.social.github && { label: 'GitHub', href: SITE.social.github },
  SITE.social.linkedin && { label: 'LinkedIn', href: SITE.social.linkedin },
].filter(Boolean) as { label: string; href: string }[];
---

<section aria-labelledby="intro-title">
  <div class="mx-auto max-w-5xl px-4 pt-16 pb-14 sm:px-6 sm:pt-28 sm:pb-20">
    <h1
      id="intro-title"
      class="text-5xl font-semibold tracking-[-0.035em] text-balance text-slate-900 sm:text-7xl dark:text-slate-50"
    >
      {SITE.name}
    </h1>

    <p
      class="mt-5 text-2xl tracking-tight text-balance text-slate-600 sm:text-3xl dark:text-slate-300"
    >
      Software developer at
      <a
        href="https://bekk.no"
        class="hover:decoration-accent-600 dark:hover:decoration-accent-300 text-slate-900 underline decoration-slate-300 decoration-2 underline-offset-[0.2em] transition-colors dark:text-slate-50 dark:decoration-slate-600"
        >Bekk</a
      > in Oslo.
    </p>

    <div
      class="mt-8 max-w-[35rem] space-y-4 text-lg leading-relaxed text-pretty text-slate-600 dark:text-slate-400"
    >
      <p>
        I studied computer science at NTNU, where I wrote my master’s thesis on
        <span class="text-slate-900 dark:text-slate-50"
          >forecasting excitement in NBA basketball games</span
        >.
      </p>
      <p>
        In my spare time I build things in Go and TypeScript, experiment with AI, and watch Formula
        1.
      </p>
    </div>

    <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-1" role="list">
      <li>
        <a href="/work" class={textLink}>
          Work history
          <Icon name="lucide:arrow-right" width={14} height={14} aria-hidden="true" />
        </a>
      </li>
      {
        external.map(({ label, href }) => (
          <li>
            <a href={href} class={textLink}>
              {label}
              <Icon name="lucide:arrow-up-right" width={14} height={14} aria-hidden="true" />
            </a>
          </li>
        ))
      }
      <li>
        <a href={`mailto:${SITE.email}`} class={textLink}>Email</a>
      </li>
    </ul>
  </div>
</section>
