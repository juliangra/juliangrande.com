---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import SelectedProjects from '@/components/home/SelectedProjects.astro';
import Background from '@/components/home/Background.astro';
import HomeSection from '@/components/home/HomeSection.astro';
import { SITE } from '@/data/site';

const textLink =
  'font-medium text-slate-900 underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-accent-600 dark:text-slate-50 dark:decoration-slate-600 dark:hover:decoration-accent-300';
---

<BaseLayout>
  <Hero />

  <SelectedProjects />

  <Background />

  <HomeSection id="contact-title" anchor="contact" title="Contact">
    <p class="text-2xl tracking-tight text-slate-600 sm:text-3xl dark:text-slate-300">
      <a href={`mailto:${SITE.email}`} class:list={[textLink, '[overflow-wrap:anywhere]']}>{SITE.email}</a>
    </p>
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      Email is the quickest way to reach me. I’m also on
      <a href={SITE.social.linkedin} class={textLink}>LinkedIn</a> and
      <a href={SITE.social.github} class={textLink}>GitHub</a>.
    </p>
  </HomeSection>
</BaseLayout>
