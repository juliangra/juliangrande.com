---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeSection from '@/components/home/HomeSection.astro';
import { SITE } from '@/data/site';
import type { WorkEntry } from '@/data/work';
import {
  bulletsWithoutThesis,
  city,
  education,
  employerGroups,
  monthSpan,
  splitRole,
  thesisOf,
} from '@/lib/work';

const groups = employerGroups();
const degrees = education();

const slug = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const role = (e: WorkEntry) => {
  const { title, context } = splitRole(e.role);
  return { title, meta: [context, city(e.location)].filter(Boolean).join(' · ') };
};
---

<BaseLayout
  title={`Work — ${SITE.name}`}
  description="Julian Grande's work history and education: Bekk, Junior Consulting, Disruptive Technologies and NTNU."
>
  <div class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24 sm:pb-16">
    <h1
      class="text-4xl font-semibold tracking-[-0.03em] text-balance text-slate-900 sm:text-5xl dark:text-slate-50"
    >
      Work history
    </h1>
    <p
      class="mt-4 max-w-[35rem] text-lg leading-relaxed text-pretty text-slate-600 dark:text-slate-400"
    >
      Every role and degree, newest first.
    </p>
  </div>

  {
    groups.map((group) => (
      <HomeSection id={slug(group.company)} title={group.company}>
        <Fragment slot="rail">
          <p class="text-sm text-slate-600 dark:text-slate-400">{group.title}</p>
          <p class="mt-0.5 font-mono text-[0.8125rem] text-slate-500 tabular-nums dark:text-slate-400">
            {group.years}
          </p>
        </Fragment>

        <ol class="divide-y divide-slate-200 dark:divide-slate-800" role="list">
          {group.roles.map((entry) => {
            const { title, meta } = role(entry);
            return (
              <li class="py-6 first:pt-0 last:pb-0">
                <div class="flex flex-col gap-x-4 gap-y-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="font-semibold tracking-tight text-slate-900 dark:text-slate-50">
                    {title}
                  </h3>
                  <span class="shrink-0 font-mono text-[0.8125rem] text-slate-500 tabular-nums dark:text-slate-400">
                    {monthSpan(entry)}
                  </span>
                </div>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{meta}</p>
                <p class="mt-3 max-w-[60ch] leading-relaxed text-pretty text-slate-700 dark:text-slate-300">
                  {entry.summary}
                </p>
                {entry.bullets.length > 0 && (
                  <ul class="mt-3 max-w-[60ch] list-disc space-y-1.5 pl-5 text-[0.9375rem] leading-relaxed text-pretty text-slate-600 marker:text-slate-400 dark:text-slate-400 dark:marker:text-slate-600">
                    {entry.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                {entry.tech.length > 0 && (
                  <p class="mt-3 font-mono text-[0.8125rem] leading-relaxed text-pretty text-slate-500 dark:text-slate-400">
                    {entry.tech.join(' · ')}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </HomeSection>
    ))
  }

  {
    degrees.length > 0 && (
      <HomeSection id="education" title="Education">
        <ol class="divide-y divide-slate-200 dark:divide-slate-800" role="list">
          {degrees.map((entry) => {
            const thesis = thesisOf(entry);
            const bullets = bulletsWithoutThesis(entry);
            return (
              <li class="py-6 first:pt-0 last:pb-0">
                <div class="flex flex-col gap-x-4 gap-y-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="font-semibold tracking-tight text-slate-900 dark:text-slate-50">
                    {entry.role}
                  </h3>
                  <span class="shrink-0 font-mono text-[0.8125rem] text-slate-500 tabular-nums dark:text-slate-400">
                    {monthSpan(entry)}
                  </span>
                </div>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                  {entry.company} · {city(entry.location)}
                </p>
                {thesis && (
                  <p class="mt-3 max-w-[60ch] text-pretty text-slate-900 dark:text-slate-50">
                    <span class="text-slate-600 dark:text-slate-400">Thesis: </span>
                    <span class="font-medium">{thesis}</span>
                  </p>
                )}
                <p class="mt-3 max-w-[60ch] leading-relaxed text-pretty text-slate-700 dark:text-slate-300">
                  {entry.summary}
                </p>
                {bullets.length > 0 && (
                  <ul class="mt-3 max-w-[60ch] list-disc space-y-1.5 pl-5 text-[0.9375rem] leading-relaxed text-pretty text-slate-600 marker:text-slate-400 dark:text-slate-400 dark:marker:text-slate-600">
                    {bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                {entry.tech.length > 0 && (
                  <p class="mt-3 font-mono text-[0.8125rem] leading-relaxed text-pretty text-slate-500 dark:text-slate-400">
                    {entry.tech.join(' · ')}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </HomeSection>
    )
  }
</BaseLayout>
